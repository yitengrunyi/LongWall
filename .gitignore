.DS_Store

# Secrets and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/

# Local scratch files
tmp/

# Local runtime data
workspace/*
